    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n\n\n\nconst item = $input.item;\n\nconst headers = item.json.headers || {};\nconst payload = item.json.body || {};\n\nconst calculated = String(\n  item.json.data || ''\n).trim().toLowerCase();\n\nconst received = String(\n  headers['x-signature-sha256'] || ''\n).trim().toLowerCase().replace(/^sha256=/, '');\n\nconst validHex = /^[0-9a-f]{64}$/;\n\nconst isValidSignature =\n  validHex.test(calculated) &&\n  validHex.test(received) &&\n  calculated === received;\n\nreturn {\n  json: {\n    isValidSignature,\n    event: payload.event || 'unknown.event',\n    payload,\n    calculatedSignaturePresent: validHex.test(calculated),\n    receivedSignaturePresent: validHex.test(received),\n    verifiedAt: new Date().toISOString()\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
