      "id": "ba0b7b29-0441-46e0-9a7b-d44baac74df3",
      "name": "Code_HandleOrderCancelled"
    },
    {
      "parameters": {
        "jsCode": "\nconst event = $input.item.json;\nconst payload = event.payload || {};\n\nreturn {\n  json: {\n    event: event.event || \"unknown.event\",\n    payload: payload,\n    status: \"LOGGED_UNKNOWN_EVENT\",\n    message: \"Unknown event type received and handled safely\",\n    processedAt: new Date().toISOString()\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        144
      ],
      "id": "bf7337fe-dc30-4980-b981-fb6dfbf5f204",
      "name": "Code_HandleUnknownEvent"
    },
    {
      "parameters": {
        "jsCode": "\nconst data = $input.item.json;\n\nreturn {\n  json: {\n    auditLogId: \"AUD-\" + Date.now(),\n    eventHandled: data.event || \"unknown.event\",\n    executionOutcome: data.status || \"UNKNOWN\",\n    referenceId:\n      data.userId ||\n      data.invoiceId ||\n      data.orderId ||\n      null,\n    message: data.message || \"\",\n    recordedAt: new Date().toISOString()\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        -192
      ],
      "id": "4d006eb1-a12d-4e65-a031-8f639982654b",
      "name": "Code_AuditTrail"
    },
    {
      "parameters": {
        "jsCode": "\nconst verification = $('Code_VerifyHMACSignature').item.json;\n\nreturn {\n  json: {\n    incidentId: \"SEC-\" + Date.now(),\n    incidentType: \"INVALID_WEBHOOK_SIGNATURE\",\n    event: verification.event || \"unknown.event\",\n    severity: \"HIGH\",\n    signatureValid: false,\n    httpStatus: 401,\n    message: \"Webhook rejected due to invalid or missing HMAC signature\",\n    recordedAt: new Date().toISOString()\n  }\n};\n"
      },
