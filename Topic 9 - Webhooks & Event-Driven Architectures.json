      "name": "Code_HandleUserCreated"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst event = $input.item.json;\nconst payload = event.payload || {};\n\nreturn {\n  json: {\n    event: event.event,\n    invoiceId: payload.invoiceId || null,\n    status: \"LEDGER_UPDATED\",\n    message: \"Invoice payment event processed successfully\",\n    processedAt: new Date().toISOString()\n  }\n};\n"
      },
